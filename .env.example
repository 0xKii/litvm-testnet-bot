# LitVM Testnet Bot Configuration

# Network
LITVM_RPC=https://liteforge.rpc.caldera.xyz/http
LITVM_CHAIN_ID=4441
LITVM_EXPLORER=https://liteforge.explorer.caldera.xyz

# Accounts (comma-separated private keys)
# Example: PRIVATE_KEYS=0xabc...,0xdef...,0x123...
PRIVATE_KEYS=

# 2Captcha API Key (for Turnstile solving)
# Get your key from: https://2captcha.com/
CAPTCHA_API_KEY=

# Proxy List (comma-separated, optional)
# Format: http://user:pass@host:port,http://user:pass@host2:port
# Leave empty to run without proxy
PROXY_LIST=

# Automation Settings
FAUCET_INTERVAL_HOURS=24
TX_PER_DAY=10
GAS_LIMIT_MULTIPLIER=1.2
MAX_RETRIES=3

# Logging
LOG_LEVEL=info
LOG_FILE=logs/litvm-bot.log

# Phase 3 - Ecosystem
DEX_SWAP_AMOUNT=0.001
NFT_MINT_ENABLED=true
DOMAIN_REGISTER_ENABLED=true

# Phase 4 - Orchestration
MULTI_ACCOUNT_ENABLED=true
ACCOUNT_DELAY_SECONDS=60
RANDOMIZE_ACTIONS=true
